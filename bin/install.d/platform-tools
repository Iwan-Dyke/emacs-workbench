#!/usr/bin/env bash
set -u

. "$(dirname "${BASH_SOURCE[0]}")/../lib.sh"

platform="${WORKBENCH_PLATFORM_OVERRIDE:-$(uname -s)}"
status=0

macos_core_packages=(
    git
    ripgrep
    fd
    coreutils
    cmake
    libtool
    pkg-config
    emacs-plus
)

apt_core_packages=(
    git
    emacs
    ripgrep
    fd-find
    build-essential
    cmake
    libtool-bin
    pkg-config
    python3
    python3-pip
    python3-venv
)

sudo_prefix() {
    if [ "$(id -u)" -eq 0 ]; then
        :
    elif have_command sudo; then
        printf "sudo\n"
    else
        fail "sudo not found; install prerequisites manually or run as root"
        return 1
    fi
}

install_macos_platform_tools() {
    if ! have_command brew; then
        fail "Homebrew not found"
        printf "Install Homebrew first:\n"
        printf '/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"\n'
        return
    fi

    if ! xcode-select -p >/dev/null 2>&1; then
        warn "Xcode command line tools not found"
        run "request Xcode command line tools install" xcode-select --install || true
        fail "finish Xcode command line tools install, then rerun ./install.sh"
        return
    fi

    must_run "tap emacs-plus" brew tap d12frosted/emacs-plus || return
    # Homebrew 7+ refuses to load formulae from third-party taps until trusted.
    # `brew trust` is a no-op on older versions that lack the subcommand.
    if brew trust --help >/dev/null 2>&1; then
        run "trust emacs-plus tap" brew trust d12frosted/emacs-plus || true
    fi
    must_run "install Homebrew core prerequisites" brew install "${macos_core_packages[@]}"
}

install_apt_platform_tools() {
    local sudo_cmd

    if ! have_command apt-get; then
        fail "unsupported Linux package manager; apt-get not found"
        return
    fi

    sudo_cmd="$(sudo_prefix)" || return

    if [ -n "$sudo_cmd" ]; then
        must_run "update apt package lists" "$sudo_cmd" apt-get update || return
        must_run "install apt core prerequisites" "$sudo_cmd" apt-get install -y "${apt_core_packages[@]}"
    else
        must_run "update apt package lists" apt-get update || return
        must_run "install apt core prerequisites" apt-get install -y "${apt_core_packages[@]}"
    fi
}

# Nerd Fonts symbols font for nerd-icons (treemacs/UI icons). Emacs ships the
# nerd-icons package but not the font, so without this the icons render as empty
# boxes. Non-fatal: a missing font only affects appearance, so failures warn
# rather than fail the whole install.
#
# Pinned to an immutable commit (not `main`) so the URL and checksum always
# agree. Upstream updates NFM.ttf in place on `main`, which previously broke the
# integrity check. To update: bump the commit SHA and the matching sha256.
nerd_font_commit="7c51b3fcd9d43b55a1540fa31174fb4589993249"
nerd_font_url="https://raw.githubusercontent.com/rainstormstudio/nerd-icons.el/${nerd_font_commit}/fonts/NFM.ttf"
nerd_font_sha256="fe471e538392f51910faab985fa8e192a39dd3426125edd15b71b3680df0e749"

install_icon_fonts() {
    local fonts_dir font_path

    if [ "$platform" = "Darwin" ]; then
        fonts_dir="$HOME/Library/Fonts"
    else
        fonts_dir="$HOME/.local/share/fonts"
    fi
    font_path="$fonts_dir/NFM.ttf"

    if [ -f "$font_path" ]; then
        printf "ok  nerd-icons font already installed\n"
        return
    fi

    mkdir -p "$fonts_dir"

    local tmp_path="$font_path.tmp"

    if have_command curl; then
        run "download nerd-icons font" curl -fsSL -o "$tmp_path" "$nerd_font_url" || {
            rm -f "$tmp_path"
            warn "could not download nerd-icons font; icons may be missing"
            return
        }
    elif have_command wget; then
        run "download nerd-icons font" wget -qO "$tmp_path" "$nerd_font_url" || {
            rm -f "$tmp_path"
            warn "could not download nerd-icons font; icons may be missing"
            return
        }
    else
        warn "neither curl nor wget found; skipping nerd-icons font"
        return
    fi

    # Verify integrity before moving to final path
    local actual_sha=""
    if have_command shasum; then
        actual_sha=$(shasum -a 256 "$tmp_path" | awk '{print $1}')
    elif have_command sha256sum; then
        actual_sha=$(sha256sum "$tmp_path" | awk '{print $1}')
    fi

    if [ -z "$actual_sha" ]; then
        rm -f "$tmp_path"
        warn "no sha256 tool found; cannot verify font integrity"
        return
    fi

    if [ "$actual_sha" != "$nerd_font_sha256" ]; then
        rm -f "$tmp_path"
        warn "nerd-icons font checksum mismatch (possible tampering); removed"
        return
    fi

    mv "$tmp_path" "$font_path"

    if [ "$platform" != "Darwin" ] && have_command fc-cache; then
        run "refresh font cache" fc-cache -f "$fonts_dir" || true
    fi
}

case "$platform" in
Darwin)
    install_macos_platform_tools
    install_icon_fonts
    ;;
Linux)
    install_apt_platform_tools
    install_icon_fonts
    ;;
*)
    fail "unsupported platform: $platform"
    ;;
esac

exit "$status"
